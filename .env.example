# Postgres. Local: docker compose up -d. Neon: `neon env pull` fills both values;
# the app uses the pooled DATABASE_URL, migrations use DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://splitbot:splitbot@localhost:5440/splitbot
# DATABASE_URL_UNPOOLED=

# OpenAI — optional. Without a key SplitBot uses its built-in rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Firebase (web app config): Firebase console → Project settings → Your apps → Web app.
# These are public by design (they ship to browsers). Firebase limits sign-in to the
# Authorized domains you list, and the server verifies every sign-in token itself.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics: from the same config, once Google Analytics is enabled for the project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Push: Project settings → Cloud Messaging → Web Push certificates → key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (server only, keep secret). Login only needs the project id; sending push
# notifications needs a service account: Project settings → Service accounts → Generate new
# private key. Paste the key on one line with \n for newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
