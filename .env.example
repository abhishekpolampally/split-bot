# Postgres. Local: docker compose up -d. Neon: `neon env pull` fills both values;
# the app uses the pooled DATABASE_URL, migrations use DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://splitbot:splitbot@localhost:5440/splitbot
# DATABASE_URL_UNPOOLED=

# OpenAI — optional. Without a key SplitBot uses its built-in rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# OTP delivery. With no SMS provider configured, codes are shown on the login
# screen and printed to the server log (fine for a private beta with friends).
OTP_DEV_MODE=true
